<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#0D0F14</color>
    <color name="accent">#2ED3B7</color>
    <style name="Theme.RepoPlayer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
    <style name="Theme.RepoPlayer.Player" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
</resources>
